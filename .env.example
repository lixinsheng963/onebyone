NODE_ENV=development
PORT=3000
APP_BASE_URL=http://127.0.0.1:3000

# Local API is memory mode by default. Set DATA_MODE=mysql after implementing the MySQL adapter.
DATA_MODE=file
AUTO_PUBLISH_SAFE=true
PUBLIC_BASE_URL=http://127.0.0.1:3000
ALLOW_DEMO_LOGIN=true
INVITE_CODE=CAMPUS
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-long-password
ADMIN_TOTP=change-this
# 生产建议使用真实 TOTP secret（Google Authenticator 等），设置后 ADMIN_TOTP 不再使用
ADMIN_TOTP_SECRET=
ADMIN_SESSION_HOURS=12
USER_SESSION_TTL_DAYS=30
SESSION_PEPPER=change-this-long-random-pepper
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=campus
MYSQL_USER=campus
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root

REDIS_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

WX_APPID=
WX_SECRET=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4.1-flash
DEEPSEEK_THINKING=false

COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=ap-guangzhou
