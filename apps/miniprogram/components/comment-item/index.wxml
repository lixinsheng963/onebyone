<view class="comment">
  <view class="comment-main">
    <image wx:if="{{comment.author.avatar && !comment.author.isAnonymous}}" class="avatar" src="{{comment.author.avatar}}" mode="aspectFill" lazy-load />
    <view wx:else class="avatar">{{comment.author.initial}}</view>
    <view class="comment-copy">
      <view class="author-row">
        <text class="comment-author">{{comment.author.isAnonymous ? comment.author.alias : comment.author.nickname}}</text>
        <text wx:if="{{comment.author.isOfficial}}" class="official">官方</text>
        <text class="comment-time">{{comment.timeText}}</text>
      </view>
      <view class="comment-text">{{comment.text}}</view>
      <view class="comment-actions">
        <text catchtap="onReply">回复</text>
        <view class="more-wrap">
          <text class="more-dot" catchtap="onMenu" data-id="{{comment.id}}" data-kind="comment">···</text>
          <view wx:if="{{menuId === comment.id}}" class="more-menu">
            <text wx:if="{{!comment.isMine}}" catchtap="onReport" data-id="{{comment.id}}" data-kind="comment">举报这条评论</text>
            <text wx:else class="more-self">自己的评论</text>
          </view>
        </view>
      </view>

      <view wx:if="{{comment.replies.length}}" class="replies">
        <view wx:for="{{comment.replies}}" wx:key="id" class="reply">
          <image wx:if="{{item.author.avatar && !item.author.isAnonymous}}" class="reply-avatar" src="{{item.author.avatar}}" mode="aspectFill" lazy-load />
          <view wx:else class="reply-avatar">{{item.author.initial}}</view>
          <view class="reply-copy">
            <view class="reply-head">
              <text class="reply-author">{{item.author.isAnonymous ? item.author.alias : item.author.nickname}}</text>
              <text wx:if="{{item.replyTo}}" class="reply-to">回复 @{{item.replyTo}}</text>
              <text class="comment-time">{{item.timeText}}</text>
            </view>
            <view class="reply-text">{{item.text}}</view>
            <view class="comment-actions">
              <text catchtap="onReply" data-reply-id="{{item.id}}">回复</text>
              <view class="more-wrap">
                <text class="more-dot" catchtap="onMenu" data-id="{{item.id}}" data-kind="reply">···</text>
                <view wx:if="{{menuId === item.id}}" class="more-menu">
                  <text wx:if="{{!item.isMine}}" catchtap="onReport" data-id="{{item.id}}" data-kind="reply">举报这条评论</text>
                  <text wx:else class="more-self">自己的评论</text>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
