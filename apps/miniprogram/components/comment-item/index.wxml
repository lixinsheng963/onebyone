<view class="comment">
  <view class="comment-main">
    <view class="avatar">{{comment.author.initial}}</view>
    <view class="comment-copy">
      <view class="author-row">
        <text class="comment-author">{{comment.author.isAnonymous ? comment.author.alias : comment.author.nickname}}</text>
        <text wx:if="{{comment.author.isOfficial}}" class="official">官方</text>
        <text class="comment-time">{{comment.timeText}}</text>
      </view>
      <view class="comment-text">{{comment.text}}</view>
      <view class="comment-actions">
        <text catchtap="onReply">回复</text>
        <text catchtap="onReport">举报</text>
      </view>

      <view wx:if="{{comment.replies.length}}" class="replies">
        <view wx:for="{{comment.replies}}" wx:key="id" class="reply">
          <view class="reply-avatar">{{item.author.initial}}</view>
          <view class="reply-copy">
            <view class="reply-head">
              <text class="reply-author">{{item.author.isAnonymous ? item.author.alias : item.author.nickname}}</text>
              <text wx:if="{{item.replyTo}}" class="reply-to">回复 @{{item.replyTo}}</text>
              <text class="comment-time">{{item.timeText}}</text>
            </view>
            <view class="reply-text">{{item.text}}</view>
            <view class="comment-actions">
              <text catchtap="onReply" data-reply-id="{{item.id}}">回复</text>
              <text catchtap="onReport">举报</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
