.post-card {
  position: relative;
  background: #fffdf8;
  border: 1rpx solid #e7e1d5;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: 0 10rpx 28rpx rgba(35, 42, 37, 0.04);
}

.rank {
  position: absolute;
  z-index: 2;
  top: 18rpx;
  left: 18rpx;
  width: 52rpx;
  height: 52rpx;
  border-radius: 14rpx;
  background: rgba(31, 35, 32, 0.78);
  color: #fff7e8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: "Songti SC", "SimSun", serif;
  font-size: 22rpx;
  letter-spacing: 0.04em;
}

.media {
  display: flex;
  width: 100%;
  overflow: hidden;
  background: #e9e2d5;
}

.media image {
  width: 100%;
  height: 100%;
  display: block;
}

.media-one {
  height: 514rpx;
}

.media-two image {
  width: calc(50% - 1rpx);
  height: 420rpx;
}

.media-two image + image {
  margin-left: 2rpx;
}

.media-grid {
  flex-wrap: wrap;
  gap: 2rpx;
}

.media-grid image {
  width: calc((100% - 4rpx) / 3);
  height: 224rpx;
}

.body {
  padding: 22rpx 24rpx 18rpx;
}

.featured {
  display: inline-flex;
  margin-bottom: 10rpx;
  color: #9c3d32;
  font-size: 20rpx;
  letter-spacing: 0.08em;
  font-weight: 600;
}

.text {
  color: #1f2328;
  font-size: 30rpx;
  line-height: 1.62;
  letter-spacing: 0.01em;
}

.meta {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  color: #7d857f;
  font-size: 22rpx;
}

.topic {
  color: #9c3d32;
}

.dot {
  margin: 0 8rpx;
}

.location {
  max-width: 360rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.author {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
}

.avatar {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #f3e4df;
  color: #9c3d32;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: "Songti SC", "SimSun", serif;
  font-size: 20rpx;
  margin-right: 10rpx;
}

.name {
  max-width: 240rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  color: #4b554f;
  font-size: 22rpx;
}

.official {
  margin-left: 8rpx;
  padding: 1rpx 7rpx;
  border-radius: 5rpx;
  color: #245b9e;
  background: #e8eff8;
  font-size: 17rpx;
}

.time {
  margin-left: auto;
  color: #9b9f99;
  font-size: 20rpx;
}

.actions {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #f0ebe1;
}

.action {
  display: flex;
  align-items: center;
  min-width: 96rpx;
  color: #7d857f;
  font-size: 22rpx;
}

.action-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 7rpx;
}

.action text.active {
  color: #b64a3a;
}

.action text.star-active {
  color: #b7791f;
}

.more {
  margin-left: auto;
  min-width: 48rpx;
  justify-content: flex-end;
}
