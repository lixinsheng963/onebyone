.sk-card {
  background: #fffdf8;
  border: 1rpx solid #e7e1d5;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.sk-cover {
  height: 514rpx;
  border-radius: 0;
}

.sk-body {
  padding: 24rpx;
}

.sk-line {
  height: 28rpx;
  margin-bottom: 14rpx;
}

.sk-line-1 {
  width: 92%;
}

.sk-line-2 {
  width: 64%;
}

.sk-meta {
  display: flex;
  align-items: center;
  margin-top: 22rpx;
}

.sk-avatar {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  margin-right: 12rpx;
}

.sk-name {
  width: 150rpx;
  height: 22rpx;
}
