<view class="appeal-page safe-page page-wrap">
  <view class="page-head">
    <view class="kicker">APPEAL / 帮助与申诉</view>
    <view class="title serif">选择内容，说明理由</view>
    <view class="sub">只处理你自己的内容；只有审核未通过（被隐藏/未通过）的内容才能申诉，请写清楚理由。</view>
  </view>

  <view wx:if="{{loading}}" class="loading-card">正在读取你的内容…</view>

  <block wx:else>
    <view class="section-line">
      <text class="section-title">我要申诉的内容</text>
      <text class="section-required">必选</text>
    </view>

    <view wx:if="{{items.length}}" class="target-list">
      <view
        wx:for="{{items}}"
        wx:key="id"
        class="target-card {{selectedId === item.id ? 'selected' : ''}}"
        bindtap="selectTarget"
        data-id="{{item.id}}"
      >
        <view class="target-cover">
          <image wx:if="{{item.cover}}" src="{{item.cover}}" mode="aspectFill" lazy-load />
          <text wx:else class="cover-letter">日常</text>
        </view>
        <view class="target-main">
          <view class="target-top">
            <text class="target-status {{item.status}}">{{item.statusText}}</text>
            <text class="target-time">{{item.time}}</text>
          </view>
          <text class="target-text">{{item.text || '（无文字内容）'}}</text>
        </view>
        <view class="target-check">{{selectedId === item.id ? '✓' : ''}}</view>
      </view>
    </view>

    <view wx:else class="empty-card">
      <text>暂无可申诉的内容</text>
      <text class="empty-sub">你还没有被隐藏或审核未通过的内容。</text>
    </view>

    <view class="field">
      <view class="field-head">
        <text class="field-label">申诉理由</text>
        <text class="field-required">必填</text>
      </view>
      <textarea
        class="textarea"
        value="{{reason}}"
        placeholder="请说明事实和你希望复核的原因，例如：这是公开活动合影，已获得本人同意；或：内容被误判，原始语境如下…"
        maxlength="800"
        bindinput="onInput"
        auto-height
      />
      <view class="reason-count">{{reason.length}} / 800</view>
    </view>

    <view class="appeal-note">提交后不能修改；同一内容只能有一条待处理申诉。请勿重复发布同一内容。</view>

    <button
      class="btn-primary submit-btn"
      bindtap="submit"
      loading="{{submitting}}"
      disabled="{{submitting || !selectedId}}"
    >提交申诉</button>
  </block>
</view>
