.appeal-page {
  padding-top: 30rpx;
}

.page-head {
  padding: 8rpx 0 24rpx;
}

.kicker {
  color: #b64a3a;
  font-size: 18rpx;
  letter-spacing: 0.18em;
  font-weight: 600;
}

.title {
  margin-top: 8rpx;
  font-size: 48rpx;
  line-height: 1.3;
}

.sub {
  margin-top: 8rpx;
  color: #7d857f;
  font-size: 22rpx;
  line-height: 1.6;
}

.case-card {
  padding: 20rpx;
  margin-bottom: 24rpx;
}

.case-label {
  color: #9b9f99;
  font-size: 19rpx;
  letter-spacing: 0.08em;
}

.case-status {
  margin-top: 8rpx;
  color: #9c3d32;
  font-size: 27rpx;
  font-weight: 600;
}

.case-reason {
  margin-top: 7rpx;
  color: #7d857f;
  font-size: 22rpx;
}

.case-tip {
  margin-top: 14rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #f0ebe1;
  color: #9b9f99;
  font-size: 20rpx;
  line-height: 1.6;
}

.field {
  margin-top: 4rpx;
}

.appeal-note {
  margin: 18rpx 0 24rpx;
  color: #9b9f99;
  font-size: 20rpx;
  line-height: 1.7;
}
