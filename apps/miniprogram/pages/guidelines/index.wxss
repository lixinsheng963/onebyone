.guide-page {
  padding-bottom: 50rpx;
}

.guide-hero {
  position: relative;
  padding: 54rpx 44rpx 50rpx;
  background:
    radial-gradient(340rpx 200rpx at 95% 10%, rgba(209, 160, 117, 0.22), transparent 70%),
    #f1ece1;
  overflow: hidden;
}

.guide-kicker {
  color: #b64a3a;
  font-size: 18rpx;
  letter-spacing: 0.18em;
  font-weight: 600;
}

.guide-title {
  margin-top: 18rpx;
  font-size: 58rpx;
  line-height: 1.35;
}

.guide-sub {
  margin-top: 16rpx;
  max-width: 560rpx;
  color: #7d857f;
  font-size: 23rpx;
  line-height: 1.75;
}

.guide-seal {
  position: absolute;
  right: 34rpx;
  bottom: 38rpx;
  width: 92rpx;
  height: 92rpx;
  border: 3rpx solid rgba(182, 74, 58, 0.55);
  border-radius: 50%;
  color: rgba(182, 74, 58, 0.65);
  font-family: "Songti SC", "SimSun", serif;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transform: rotate(-10deg);
}

.rule {
  display: flex;
  gap: 18rpx;
  padding: 26rpx 0;
  border-bottom: 1rpx solid #e7e1d5;
}

.rule-no {
  color: #b64a3a;
  font-size: 18rpx;
  letter-spacing: 0.08em;
  padding-top: 5rpx;
}

.rule-copy {
  flex: 1;
}

.rule-title {
  color: #1f2328;
  font-size: 30rpx;
  font-weight: 600;
}

.rule-text {
  margin-top: 7rpx;
  color: #7d857f;
  font-size: 23rpx;
  line-height: 1.8;
}

.guide-box {
  margin-top: 24rpx;
  padding: 22rpx;
  border-radius: 18rpx;
  background: #fdf6f1;
  border: 1rpx solid #ecd8cf;
}

.guide-box.soft {
  background: #f4f1e8;
  border-color: #e5dece;
}

.box-title {
  font-size: 28rpx;
  color: #1f2328;
}

.box-text {
  margin-top: 7rpx;
  color: #7d857f;
  font-size: 22rpx;
  line-height: 1.75;
}

.box-link {
  margin-top: 10rpx;
  color: #b64a3a;
  font-size: 22rpx;
}

.guide-foot {
  display: flex;
  flex-direction: column;
  gap: 5rpx;
  margin-top: 40rpx;
  color: #b0b2ac;
  font-size: 18rpx;
  letter-spacing: 0.05em;
}

.home-btn {
  margin-top: 28rpx;
  width: 100%;
}
