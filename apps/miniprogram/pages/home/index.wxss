.home {
  padding-bottom: 40rpx;
}

.emergency {
  margin: 20rpx 32rpx 0;
  min-height: 92rpx;
  padding: 16rpx 20rpx;
  border-radius: 18rpx;
  background:
    radial-gradient(300rpx 120rpx at 100% 0%, rgba(255, 255, 255, 0.18), transparent 70%),
    linear-gradient(135deg, #c3352f, #972524);
  color: #fff;
  display: flex;
  align-items: center;
  box-shadow: 0 12rpx 26rpx rgba(151, 37, 36, 0.18);
}

.emergency-label {
  flex: none;
  padding: 4rpx 9rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.45);
  border-radius: 6rpx;
  font-size: 18rpx;
  letter-spacing: 0.08em;
  margin-right: 14rpx;
}

.emergency-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 3rpx;
}

.emergency-title {
  font-size: 26rpx;
  font-weight: 600;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.emergency-sub {
  font-size: 19rpx;
  color: rgba(255, 255, 255, 0.68);
}

.emergency-arrow {
  font-size: 34rpx;
  opacity: 0.7;
  margin-left: 8rpx;
}

.home-head {
  padding: 32rpx 0 20rpx;
}

.date-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.date {
  color: #7d857f;
  font-size: 22rpx;
  letter-spacing: 0.06em;
}

.message {
  position: relative;
  width: 72rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.message-icon {
  width: 40rpx;
  height: 40rpx;
}

.unread {
  position: absolute;
  top: 10rpx;
  right: 4rpx;
  width: 13rpx;
  height: 13rpx;
  border-radius: 50%;
  background: #c3352f;
  border: 3rpx solid #f7f5f0;
}

.hero-title {
  margin-top: 18rpx;
  font-size: 48rpx;
  line-height: 1.25;
  letter-spacing: 0.01em;
  font-weight: 500;
}

.hero-sub {
  margin-top: 10rpx;
  color: #7d857f;
  font-size: 23rpx;
  letter-spacing: 0.02em;
}

.official-card {
  display: flex;
  align-items: stretch;
  background: #fffdf8;
  border: 1rpx solid #e7e1d5;
  border-radius: 20rpx;
  padding: 18rpx 18rpx 17rpx 0;
  margin-bottom: 24rpx;
  overflow: hidden;
}

.official-rail {
  width: 6rpx;
  background: #245b9e;
  border-radius: 0 4rpx 4rpx 0;
  margin-right: 16rpx;
}

.official-copy {
  flex: 1;
  min-width: 0;
}

.official-top {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.badge-official {
  height: 30rpx;
  font-size: 18rpx;
}

.official-source {
  color: #9b9f99;
  font-size: 19rpx;
}

.official-title {
  margin-top: 9rpx;
  font-size: 27rpx;
  font-weight: 600;
  color: #1f2328;
}

.official-body {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #7d857f;
}

.official-arrow {
  align-self: center;
  color: #9b9f99;
  font-size: 30rpx;
  margin-left: 10rpx;
}

.tabs-wrap {
  position: sticky;
  top: 0;
  z-index: 5;
  background: rgba(247, 245, 240, 0.96);
  padding-top: 2rpx;
}

.tabs {
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #e7e1d5;
}

.tab {
  position: relative;
  height: 76rpx;
  line-height: 76rpx;
  margin-right: 42rpx;
  color: #7d857f;
  font-size: 27rpx;
}

.tab.active {
  color: #1f2328;
  font-weight: 600;
}

.tab-line {
  position: absolute;
  left: 50%;
  bottom: -1rpx;
  width: 28rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: #b64a3a;
  transform: translateX(-50%);
}

.topics {
  width: 100%;
  padding: 20rpx 0 4rpx;
  white-space: nowrap;
}

.topic-inner {
  display: inline-flex;
  gap: 12rpx;
  padding-right: 32rpx;
}

.topic-chip {
  display: inline-flex;
  align-items: center;
  height: 54rpx;
  padding: 0 22rpx;
  border-radius: 27rpx;
  border: 1rpx solid #e0d9cb;
  color: #7d857f;
  font-size: 22rpx;
  background: #fffdf8;
}

.topic-chip.active {
  color: #9c3d32;
  border-color: #d9b6ab;
  background: #f3e4df;
}

.feed {
  padding-top: 4rpx;
}

.error-box {
  padding: 100rpx 20rpx;
  text-align: center;
}

.error-title {
  font-size: 34rpx;
}

.error-sub {
  margin: 10rpx 0 28rpx;
  color: #7d857f;
  font-size: 24rpx;
}

.empty-wrap {
  margin-top: 14rpx;
}

.end-line {
  display: flex;
  align-items: center;
  gap: 14rpx;
  color: #a9aca5;
  font-size: 20rpx;
  padding: 22rpx 0 34rpx;
}

.end-line-rule {
  flex: 1;
  height: 1rpx;
  background: #e7e1d5;
}
