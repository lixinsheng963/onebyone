<view class="me-page safe-page">
  <view wx:if="{{user}}" class="page-wrap">
    <view class="me-head">
      <view class="me-kicker">MY CAMPUS</view>
      <view class="me-title serif">我的日常</view>
      <view class="me-profile">
        <view class="me-avatar">{{userInitial}}</view>
        <view class="me-profile-copy">
          <view class="me-name">
            {{user.nickname}}
            <text wx:if="{{user.level === 'L2'}}" class="verified">本校认证</text>
            <text wx:if="{{user.isOfficial}}" class="badge badge-official">官方</text>
          </view>
          <view class="me-sub">{{user.school || '示例大学'}} · {{user.bio || '把今天的小事记下来'}}</view>
        </view>
      </view>
    </view>

    <view class="stats-card card">
      <view class="stat-item" data-type="posts" bindtap="goList">
        <text class="stat-num">{{stats.posts}}</text>
        <text class="stat-label">发布</text>
      </view>
      <view class="stat-rule"></view>
      <view class="stat-item" data-type="comments" bindtap="goList">
        <text class="stat-num">{{stats.comments}}</text>
        <text class="stat-label">评论</text>
      </view>
      <view class="stat-rule"></view>
      <view class="stat-item" data-type="favorites" bindtap="goList">
        <text class="stat-num">{{stats.favorites}}</text>
        <text class="stat-label">收藏</text>
      </view>
    </view>

    <view wx:if="{{pending}}" class="pending-tip" data-type="posts" bindtap="goList">
      <view class="pending-dot"></view>
      <text>{{pending}} 条内容正在审核中</text>
      <text class="pending-arrow">›</text>
    </view>

    <view class="menu-card card">
      <view class="menu-row" data-type="posts" bindtap="goList">
        <view class="menu-icon warm">▤</view>
        <view class="menu-copy"><text class="menu-title">我的发布</text><text>已发布 / 审核中 / 未通过</text></view>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-row" data-type="comments" bindtap="goList">
        <view class="menu-icon green">◌</view>
        <view class="menu-copy"><text class="menu-title">我的评论</text><text>你留在校园里的回声</text></view>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-row" data-type="favorites" bindtap="goList">
        <view class="menu-icon amber">☆</view>
        <view class="menu-copy"><text class="menu-title">我的收藏</text><text>留着以后再看</text></view>
        <text class="menu-arrow">›</text>
      </view>
    </view>

    <view class="menu-card card">
      <view class="menu-row" bindtap="goGuidelines">
        <view class="menu-icon plain">◎</view>
        <view class="menu-copy"><text class="menu-title">社区公约</text><text>什么可以发，什么不要发</text></view>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-row" bindtap="goAppeal">
        <view class="menu-icon plain">↺</view>
        <view class="menu-copy"><text class="menu-title">帮助与申诉</text><text>内容被误判？在这里说</text></view>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-row" bindtap="goSettings">
        <view class="menu-icon plain">⚙</view>
        <view class="menu-copy"><text class="menu-title">设置</text><text>通知、隐私、账号</text></view>
        <text class="menu-arrow">›</text>
      </view>
    </view>

    <view class="me-footer">
      <text>CAMPUS DAILY</text>
      <text>只记录这一所学校今天的小事</text>
    </view>
  </view>

  <view wx:else class="guest-wrap">
    <view class="guest-stamp">日</view>
    <view class="guest-title serif">登录后，<br />把今天留在这里。</view>
    <view class="guest-sub">浏览不需要登录；登录后可以点赞、收藏、评论和发布。</view>
    <button class="btn-primary" bindtap="goAuth">微信登录 / 校园认证</button>
    <view class="guest-link" bindtap="goGuidelines">先看看社区公约 ›</view>
  </view>
</view>
