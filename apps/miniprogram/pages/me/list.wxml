<wxs module="fmt" src="../../utils/format.wxs" />
<view class="list-page safe-page page-wrap">
  <view class="list-head">
    <view class="list-kicker">MY CAMPUS / {{type}}</view>
    <view class="list-title serif">{{title}}</view>
  </view>

  <view wx:if="{{loading}}" class="loading">
    <view class="skeleton loading-line"></view>
    <view class="skeleton loading-line short"></view>
    <view class="skeleton loading-line"></view>
  </view>

  <view wx:elif="{{!items.length}}" class="empty-wrap">
    <empty-state
      title="{{type === 'posts' ? '还没有发布过内容' : type === 'comments' ? '还没有评论过' : '还没有收藏'}}"
      sub="{{type === 'posts' ? '今天校园里有什么，写下来吧。' : '去首页看看，遇到喜欢的就留下来。'}}"
      actionText="{{type === 'posts' ? '去发布' : '去首页'}}"
      bind:action="onEmptyAction"
    />
  </view>

  <block wx:elif="{{type === 'favorites'}}">
    <post-card
      wx:for="{{items}}"
      wx:key="id"
      post="{{item}}"
      bind:open="onOpen"
      bind:like="onCardLike"
      bind:comment="onCardComment"
      bind:favorite="onCardFavorite"
      bind:more="onCardMore"
    />
  </block>

  <block wx:elif="{{type === 'posts'}}">
    <view wx:for="{{items}}" wx:key="id" class="moment-card card press" data-id="{{item.id}}" bindtap="onOpen">
      <view class="moment-head">
        <view class="row-badges">
          <text class="status {{item.status}}">{{item.statusText}}</text>
          <text wx:if="{{item.pinnedAt}}" class="pinned-badge">置顶</text>
        </view>
        <text class="moment-date">{{item.dateText}}</text>
      </view>

      <view class="moment-text">{{item.text}}</view>

      <view wx:if="{{item.media.length}}" class="moment-media {{item.media.length === 1 ? 'single' : item.media.length === 2 ? 'two' : 'grid'}}">
        <image
          wx:for="{{item.media}}"
          wx:for-item="photo"
          wx:key="id"
          src="{{photo.url}}"
          mode="aspectFill"
          lazy-load
        />
      </view>

      <view class="moment-meta">
        <text wx:if="{{item.topic}}">#{{item.topic}}</text>
        <text wx:if="{{item.location}}">· {{item.location}}</text>
        <text class="row-count">♡ {{fmt.count(item.likeCount)}}　💬 {{fmt.count(item.commentCount)}}</text>
      </view>

      <view class="moment-foot">
        <text class="moment-relative">{{item.timeText}}</text>
        <view class="moment-actions">
          <text catchtap="togglePin" data-id="{{item.id}}">{{item.pinnedAt ? '取消置顶' : '置顶'}}</text>
          <text class="danger" catchtap="deletePost" data-id="{{item.id}}">删除</text>
        </view>
      </view>
    </view>
  </block>

  <block wx:else>
    <view
      wx:for="{{items}}"
      wx:key="threadId"
      class="thread-card card press"
      data-postid="{{item.post.publicId}}"
      bindtap="onOpen"
    >
      <view class="thread-head">
        <view class="thread-post-copy">
          <view class="thread-label">{{item.label}}</view>
          <view class="thread-post-text">{{item.post.excerpt}}</view>
          <view class="thread-post-meta">
            <text wx:if="{{item.post.topic}}">#{{item.post.topic}}</text>
            <text>{{item.post.authorNickname}}</text>
            <text>{{item.post.isMine ? '我发布的' : '来自分享'}}</text>
          </view>
        </view>
        <image wx:if="{{item.post.cover}}" class="thread-cover" src="{{item.post.cover}}" mode="aspectFill" lazy-load />
      </view>

      <view class="thread-list">
        <view
          wx:for="{{item.comments}}"
          wx:for-item="comment"
          wx:key="id"
          class="thread-comment {{comment.context ? 'context' : ''}}"
        >
          <view class="thread-avatar">{{comment.authorInitial}}</view>
          <view class="thread-body">
            <view class="thread-name-line">
              <text class="thread-name">{{comment.authorName}}</text>
              <text class="thread-role {{comment.mine ? 'mine' : comment.replyToMe ? 'incoming' : ''}}">{{comment.roleText}}</text>
              <text class="thread-time">{{comment.timeText}}</text>
            </view>
            <view class="thread-text">{{comment.text}}</view>
          </view>
        </view>
      </view>

      <view class="thread-open">查看原帖 <text>›</text></view>
    </view>
  </block>
</view>
