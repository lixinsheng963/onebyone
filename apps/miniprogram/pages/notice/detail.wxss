.notice-detail {
  min-height: 100vh;
}

.loading {
  padding-top: 40rpx;
}

.line {
  height: 34rpx;
  margin-bottom: 20rpx;
}

.line.short {
  width: 60%;
}

.notice-head {
  padding: 56rpx 32rpx 48rpx;
  color: #1f2328;
  background: #e8eff8;
}

.notice-head.emergency {
  color: #fff;
  background:
    radial-gradient(400rpx 200rpx at 100% 0%, rgba(255, 255, 255, 0.16), transparent 70%),
    linear-gradient(140deg, #a52b27, #7d1f1e);
}

.notice-label {
  display: inline-flex;
  padding: 4rpx 10rpx;
  border: 1rpx solid currentColor;
  border-radius: 6rpx;
  font-size: 18rpx;
  letter-spacing: 0.1em;
  opacity: 0.8;
}

.notice-title {
  margin-top: 22rpx;
  font-size: 48rpx;
  line-height: 1.4;
}

.notice-source {
  margin-top: 18rpx;
  font-size: 21rpx;
  opacity: 0.68;
}

.notice-body-wrap {
  padding-top: 34rpx;
}

.notice-body {
  font-size: 31rpx;
  line-height: 1.9;
  white-space: pre-wrap;
}

.notice-meta {
  margin-top: 34rpx;
  padding: 8rpx 22rpx;
}

.meta-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0ebe1;
  font-size: 22rpx;
}

.meta-row:last-child {
  border-bottom: 0;
}

.meta-row text:first-child {
  color: #7d857f;
}

.notice-tip {
  margin-top: 22rpx;
  padding: 18rpx 20rpx;
  border-radius: 14rpx;
  background: #fbf0dc;
  color: #8b5716;
  font-size: 21rpx;
  line-height: 1.7;
}

.notice-foot {
  margin-top: 44rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18rpx;
  color: #9b9f99;
  font-size: 19rpx;
}

.empty {
  padding: 160rpx 40rpx;
  text-align: center;
}

.empty-title {
  font-size: 36rpx;
  margin-bottom: 30rpx;
}
