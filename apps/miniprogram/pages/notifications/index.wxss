.notice-page {
  padding-top: 32rpx;
  padding-bottom: 40rpx;
}

.page-head {
  padding: 8rpx 0 18rpx;
}

.kicker {
  color: #b64a3a;
  font-size: 18rpx;
  letter-spacing: 0.18em;
  font-weight: 600;
}

.title {
  margin-top: 8rpx;
  font-size: 50rpx;
  line-height: 1.25;
}

.sub {
  margin-top: 8rpx;
  color: #7d857f;
  font-size: 22rpx;
}

.tabs {
  display: flex;
  gap: 34rpx;
  border-bottom: 1rpx solid #e7e1d5;
  margin-bottom: 14rpx;
}

.tab {
  position: relative;
  height: 76rpx;
  line-height: 76rpx;
  color: #7d857f;
  font-size: 25rpx;
}

.tab.active {
  color: #1f2328;
  font-weight: 600;
}

.tab.active::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: -1rpx;
  width: 26rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: #b64a3a;
  transform: translateX(-50%);
}

.loading {
  padding-top: 20rpx;
}

.line {
  height: 30rpx;
  margin-bottom: 18rpx;
}

.line.short {
  width: 64%;
}

.list {
  padding-top: 12rpx;
}

.notice-row {
  display: flex;
  gap: 12rpx;
  position: relative;
  padding: 20rpx;
  margin-bottom: 14rpx;
}

.notice-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  font-size: 21rpx;
  font-family: "Songti SC", "SimSun", serif;
}

.notice-icon.interaction { background: #e8efe7; color: #4d6b56; }
.notice-icon.review { background: #f3e4df; color: #9c3d32; }
.notice-icon.official { background: #e8eff8; color: #245b9e; }

.notice-copy {
  flex: 1;
  min-width: 0;
}

.notice-top {
  display: flex;
  align-items: baseline;
}

.notice-title {
  flex: 1;
  font-size: 26rpx;
  font-weight: 600;
}

.notice-time {
  color: #9b9f99;
  font-size: 19rpx;
}

.notice-body {
  margin-top: 6rpx;
  color: #7d857f;
  font-size: 22rpx;
  line-height: 1.55;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.unread-dot {
  position: absolute;
  top: 22rpx;
  right: 18rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #b64a3a;
}

.empty-wrap {
  margin-top: 20rpx;
}
