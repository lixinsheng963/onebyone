.detail {
  padding-bottom: 0;
}

.detail-loading {
  padding-top: 28rpx;
}

.loading-cover {
  height: 514rpx;
  border-radius: 24rpx;
}

.loading-line {
  height: 30rpx;
  margin-top: 24rpx;
}

.loading-line.short {
  width: 62%;
}

.error-box {
  padding: 140rpx 40rpx;
  text-align: center;
}

.error-title {
  font-size: 34rpx;
  margin-bottom: 26rpx;
}

.hero-media {
  margin-top: 24rpx;
  border-radius: 24rpx;
  overflow: hidden;
  height: 540rpx;
  background: #e9e2d5;
}

.hero-media image {
  width: 100%;
  height: 100%;
}

.double-media {
  display: flex;
  gap: 2rpx;
  margin-top: 24rpx;
  border-radius: 24rpx;
  overflow: hidden;
  height: 450rpx;
}

.double-media image {
  width: calc(50% - 1rpx);
  height: 100%;
}

.detail-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 2rpx;
  margin-top: 24rpx;
  border-radius: 24rpx;
  overflow: hidden;
}

.detail-grid image {
  width: calc((100% - 4rpx) / 3);
  height: 224rpx;
}

.post-body {
  padding-top: 30rpx;
}

.featured {
  display: inline-flex;
  margin-bottom: 12rpx;
  color: #9c3d32;
  font-size: 21rpx;
  letter-spacing: 0.08em;
  font-weight: 600;
}

.post-text {
  color: #1f2328;
  font-size: 34rpx;
  line-height: 1.78;
  letter-spacing: 0.01em;
}

.meta-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 18rpx;
  color: #7d857f;
  font-size: 22rpx;
}

.topic {
  color: #9c3d32;
}

.meta-location {
  margin-left: 10rpx;
}

.meta-time {
  margin-left: auto;
  color: #9b9f99;
}

.author-row {
  display: flex;
  align-items: center;
  margin-top: 26rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid #e7e1d5;
  border-bottom: 1rpx solid #e7e1d5;
}

.author-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #f3e4df;
  color: #9c3d32;
  font-family: "Songti SC", "SimSun", serif;
  font-size: 25rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 14rpx;
}

.author-copy {
  flex: 1;
}

.author-name {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #1f2328;
  font-size: 25rpx;
}

.author-sub {
  margin-top: 4rpx;
  color: #9b9f99;
  font-size: 20rpx;
}

.author-mark {
  color: #c7b9a3;
  font-size: 17rpx;
  letter-spacing: 0.18em;
  font-family: "Songti SC", "SimSun", serif;
}

.disclaimer {
  margin-top: 20rpx;
  padding: 16rpx 18rpx;
  background: #f1ede4;
  border-radius: 12rpx;
  color: #9b9f99;
  font-size: 20rpx;
  line-height: 1.6;
}

.comments-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 0 4rpx;
}

.comments-title {
  font-size: 34rpx;
  font-weight: 500;
}

.comments-title text {
  margin-left: 5rpx;
  color: #9b9f99;
  font-family: -apple-system, "PingFang SC", sans-serif;
  font-size: 23rpx;
  font-weight: 400;
}

.comments-sort {
  color: #7d857f;
  font-size: 22rpx;
}

.comments {
  padding-bottom: 18rpx;
}

.comments-closed,
.comments-empty {
  padding: 44rpx 0 50rpx;
  text-align: center;
  color: #9b9f99;
  font-size: 23rpx;
}

.bottom-space {
  height: 180rpx;
}

.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  padding: 14rpx 22rpx calc(14rpx + env(safe-area-inset-bottom));
  background: rgba(255, 253, 248, 0.97);
  border-top: 1rpx solid #e7e1d5;
  box-shadow: 0 -10rpx 28rpx rgba(35, 42, 37, 0.04);
}

.comment-input-preview {
  flex: 1;
  height: 68rpx;
  line-height: 68rpx;
  border-radius: 34rpx;
  padding: 0 22rpx;
  color: #9b9f99;
  background: #f4f0e7;
  font-size: 23rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.action-icon-wrap {
  width: 78rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #7d857f;
  font-size: 20rpx;
}

.action-icon {
  width: 38rpx;
  height: 38rpx;
}

.action-icon-wrap text {
  margin-left: 3rpx;
}

.action-icon-wrap text.active {
  color: #b64a3a;
}

.action-icon-wrap text.star {
  color: #b7791f;
}

.share-btn {
  width: 58rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.comment-composer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  background: #fffdf8;
  border-top: 1rpx solid #e7e1d5;
  padding: 14rpx 22rpx calc(14rpx + env(safe-area-inset-bottom));
  animation: composer-in 0.18s ease-out;
}

@keyframes composer-in {
  from { transform: translateY(20rpx); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

.reply-banner {
  display: flex;
  justify-content: space-between;
  padding: 4rpx 4rpx 12rpx;
  color: #7d857f;
  font-size: 21rpx;
}

.reply-cancel {
  color: #b64a3a;
}

.composer-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.anon-switch {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 66rpx;
  gap: 2rpx;
}

.anon-switch switch {
  transform: scale(0.65);
}

.anon-switch text {
  color: #7d857f;
  font-size: 18rpx;
}

.composer-input {
  flex: 1;
  min-height: 68rpx;
  max-height: 180rpx;
  border-radius: 18rpx;
  background: #f4f0e7;
  padding: 14rpx 18rpx;
  font-size: 27rpx;
  line-height: 1.55;
}

.send-btn {
  width: 90rpx;
  height: 64rpx;
  border-radius: 32rpx;
  background: #d9c7c0;
  color: #fff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.send-btn.ready {
  background: #b64a3a;
}
