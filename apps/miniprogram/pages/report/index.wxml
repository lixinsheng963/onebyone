<view class="report-page safe-page page-wrap">
  <view class="page-head">
    <view class="kicker">REPORT / 保持边界</view>
    <view class="title serif">举报这条内容</view>
    <view class="sub">举报会进入人工队列；恶意举报也会被记录。</view>
  </view>

  <view class="reason-list">
    <view
      wx:for="{{reasons}}"
      wx:key="key"
      class="reason card {{selected === item.key ? 'active' : ''}}"
      data-key="{{item.key}}"
      bindtap="select"
    >
      <view class="radio"><view wx:if="{{selected === item.key}}" class="radio-dot"></view></view>
      <view class="reason-copy">
        <text class="reason-label">{{item.label}}</text>
        <text class="reason-hint">{{item.hint}}</text>
      </view>
    </view>
  </view>

  <view class="field">
    <text class="field-label">补充说明（选填）</text>
    <textarea
      class="textarea"
      value="{{detail}}"
      placeholder="可以写清楚哪一句/哪张图有问题，方便我们处理。"
      maxlength="500"
      bindinput="onDetail"
    />
  </view>

  <view class="report-note">如果涉及现实人身安全，请先联系学校保卫处或拨打 110/120。</view>

  <button class="btn-primary" bindtap="submit" loading="{{submitting}}" disabled="{{submitting}}">提交举报</button>
</view>
