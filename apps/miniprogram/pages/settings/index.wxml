<view class="settings-page safe-page page-wrap">
  <view class="page-head">
    <view class="kicker">SETTINGS / 边界与隐私</view>
    <view class="title serif">设置</view>
  </view>

  <view wx:if="{{!user}}" class="guest-card card" bindtap="goAuth">
    <view>
      <text class="guest-title">还没有登录</text>
      <text>登录后可管理通知、隐私和账号。</text>
    </view>
    <text class="arrow">›</text>
  </view>

  <view class="group card">
    <view class="group-title">通知</view>
    <view class="row">
      <view><text class="row-title">互动通知</text><text>有人回复你时提醒</text></view>
      <switch checked="{{notify}}" color="#b64a3a" bindchange="toggleNotify" />
    </view>
    <view class="row">
      <view><text class="row-title">审核结果</text><text>内容通过/未通过时提醒</text></view>
      <switch checked="{{true}}" color="#b64a3a" disabled="{{true}}" />
    </view>
  </view>

  <view class="group card">
    <view class="group-title">显示</view>
    <view class="row">
      <view><text class="row-title">深色模式</text><text>P2；先把校报感做稳</text></view>
      <switch checked="{{dark}}" color="#b64a3a" bindchange="toggleDark" />
    </view>
    <view class="row press" bindtap="clearCache">
      <view><text class="row-title">清理缓存</text><text>草稿、图片临时文件、登录状态</text></view>
      <text class="arrow">›</text>
    </view>
  </view>

  <view class="group card">
    <view class="group-title">关于</view>
    <view class="row press" bindtap="guidelines">
      <view><text class="row-title">社区公约</text><text>发什么、不发什么、怎么申诉</text></view>
      <text class="arrow">›</text>
    </view>
    <view class="row press" bindtap="privacy">
      <view><text class="row-title">隐私说明</text><text>我们收集什么、不收集什么</text></view>
      <text class="arrow">›</text>
    </view>
    <view class="row">
      <view><text class="row-title">版本</text><text>v0.1.0 · 单校版 MVP</text></view>
      <text class="version">CAMPUS</text>
    </view>
  </view>

  <view wx:if="{{user}}" class="danger-zone">
    <button class="logout-btn" bindtap="logout">退出登录</button>
    <button class="delete-btn" bindtap="deleteAccount">注销账号</button>
  </view>

  <view class="settings-foot">校园日常 · 只记录这一所学校今天的小事</view>
</view>
