.settings-page {
  padding-top: 28rpx;
  padding-bottom: 50rpx;
}

.page-head {
  padding: 8rpx 0 24rpx;
}

.kicker {
  color: #b64a3a;
  font-size: 18rpx;
  letter-spacing: 0.18em;
  font-weight: 600;
}

.title {
  margin-top: 8rpx;
  font-size: 48rpx;
  line-height: 1.3;
}

.guest-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx;
  margin-bottom: 18rpx;
}

.guest-title {
  display: block;
  font-size: 26rpx;
  color: #1f2328;
  font-weight: 600;
}

.guest-card text {
  display: block;
  margin-top: 5rpx;
  color: #7d857f;
  font-size: 20rpx;
}

.arrow {
  color: #b0b2ac;
  font-size: 30rpx;
}

.group {
  margin-bottom: 18rpx;
  padding: 0 20rpx;
}

.group-title {
  padding: 18rpx 0 6rpx;
  color: #9b9f99;
  font-size: 19rpx;
  letter-spacing: 0.08em;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 17rpx 0;
  border-top: 1rpx solid #f0ebe1;
}

.row-title {
  display: block;
  font-size: 26rpx;
  font-weight: 500;
  color: #1f2328;
}

.row text {
  display: block;
  margin-top: 4rpx;
  color: #9b9f99;
  font-size: 20rpx;
}

.version {
  color: #b0b2ac !important;
  font-size: 17rpx !important;
  letter-spacing: 0.12em;
}

.danger-zone {
  margin-top: 30rpx;
}

.logout-btn,
.delete-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 84rpx;
  padding: 0;
  line-height: 1;
  text-align: center;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: #fffdf8;
  border: 1rpx solid #e7e1d5;
  color: #7d857f;
  font-size: 25rpx;
  margin-bottom: 12rpx;
}

.logout-btn::after,
.delete-btn::after {
  border: 0;
}

.delete-btn {
  color: #b3352e;
  border-color: #edcfc9;
  background: #fdf6f3;
}

.settings-foot {
  margin-top: 36rpx;
  text-align: center;
  color: #b8b5ac;
  font-size: 18rpx;
  letter-spacing: 0.05em;
}

.profile-card { display: flex; align-items: center; gap: 18rpx; padding: 24rpx; margin-bottom: 22rpx; }
.profile-avatar { width: 88rpx; height: 88rpx; border-radius: 50%; flex: none; background: #f3e4df; }
.profile-avatar-fallback { display: flex; align-items: center; justify-content: center; color: #9c3d32; font-family: "Songti SC", serif; font-size: 34rpx; }
.profile-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6rpx; }
.profile-name { font-size: 32rpx; color: #2f3a33; font-weight: 600; }
.profile-sub { color: #8b857b; font-size: 21rpx; line-height: 1.5; }
.profile-edit { flex: none; padding: 10rpx 18rpx; border: 1rpx solid #d8cfc0; border-radius: 999rpx; background: transparent; color: #4b554f; font-size: 22rpx; line-height: 1.4; }
.profile-edit::after { border: 0; }
.profile-editor { padding: 24rpx; margin-bottom: 22rpx; display: flex; flex-direction: column; gap: 20rpx; }
.profile-editor-row { display: flex; align-items: center; gap: 20rpx; }
.profile-editor-actions { display: flex; justify-content: flex-end; gap: 14rpx; }
.btn-ghost, .btn-primary { padding: 12rpx 24rpx; border-radius: 999rpx; font-size: 23rpx; line-height: 1.5; }
.btn-ghost { background: #faf6ee; color: #4b554f; border: 1rpx solid #e7dfd1; }
.btn-primary { background: #4b554f; color: #fff; border: 1rpx solid #4b554f; }
.btn-ghost::after, .btn-primary::after { border: 0; }
.field { display: flex; flex-direction: column; gap: 10rpx; color: #6f6a60; font-size: 22rpx; }
.field .input { width: 100%; box-sizing: border-box; padding: 18rpx 20rpx; border: 1rpx solid #e7dfd1; border-radius: 12rpx; background: #fffdf8; font-size: 26rpx; color: #2f3a33; }
