.settings-page {
  padding-top: 28rpx;
  padding-bottom: 50rpx;
}

.page-head {
  padding: 8rpx 0 24rpx;
}

.kicker {
  color: #b64a3a;
  font-size: 18rpx;
  letter-spacing: 0.18em;
  font-weight: 600;
}

.title {
  margin-top: 8rpx;
  font-size: 48rpx;
  line-height: 1.3;
}

.guest-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx;
  margin-bottom: 18rpx;
}

.guest-title {
  display: block;
  font-size: 26rpx;
  color: #1f2328;
  font-weight: 600;
}

.guest-card text {
  display: block;
  margin-top: 5rpx;
  color: #7d857f;
  font-size: 20rpx;
}

.arrow {
  color: #b0b2ac;
  font-size: 30rpx;
}

.group {
  margin-bottom: 18rpx;
  padding: 0 20rpx;
}

.group-title {
  padding: 18rpx 0 6rpx;
  color: #9b9f99;
  font-size: 19rpx;
  letter-spacing: 0.08em;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 17rpx 0;
  border-top: 1rpx solid #f0ebe1;
}

.row-title {
  display: block;
  font-size: 26rpx;
  font-weight: 500;
  color: #1f2328;
}

.row text {
  display: block;
  margin-top: 4rpx;
  color: #9b9f99;
  font-size: 20rpx;
}

.version {
  color: #b0b2ac !important;
  font-size: 17rpx !important;
  letter-spacing: 0.12em;
}

.danger-zone {
  margin-top: 30rpx;
}

.logout-btn,
.delete-btn {
  width: 100%;
  height: 84rpx;
  border-radius: 16rpx;
  background: #fffdf8;
  border: 1rpx solid #e7e1d5;
  color: #7d857f;
  font-size: 25rpx;
  margin-bottom: 12rpx;
}

.delete-btn {
  color: #b3352e;
  border-color: #edcfc9;
  background: #fdf6f3;
}

.settings-foot {
  margin-top: 36rpx;
  text-align: center;
  color: #b8b5ac;
  font-size: 18rpx;
  letter-spacing: 0.05em;
}
