# Copy to deploy/.env and replace every value before production.
NODE_ENV=production
PORT=3000
DATA_MODE=mysql
AUTO_PUBLISH_SAFE=true
ALLOW_DEMO_LOGIN=false
INVITE_CODE=change-this-invite-code
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-long-password
ADMIN_TOTP=change-this
ADMIN_TOTP_SECRET=
ADMIN_SESSION_HOURS=12
USER_SESSION_TTL_DAYS=30
SESSION_PEPPER=change-this-long-random-pepper
CORS_ORIGINS=https://admin.example.com
TRUST_PROXY=true
APP_BASE_URL=https://api.example.com
ADMIN_BASE_URL=https://admin.example.com
PUBLIC_BASE_URL=https://api.example.com

MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=campus
MYSQL_USER=campus
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root

REDIS_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-this-redis-password

WX_APPID=
WX_SECRET=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4.1-flash
DEEPSEEK_THINKING=false

COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=ap-guangzhou
