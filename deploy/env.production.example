# Copy to apps/api/.env on the production server. Never commit real secrets.
# The API refuses to start when NODE_ENV=production and any required value is missing.
NODE_ENV=production
PORT=3000
TRUST_PROXY=true
# Global requests per minute per client IP. Keep 300 in production; raise only behind a trusted gateway.
RATE_LIMIT_MAX=300
PUBLIC_BASE_URL=https://campus.example.com
CORS_ORIGINS=https://campus.example.com
DATA_MODE=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=campus
MYSQL_USER=campus
MYSQL_PASSWORD=CHANGE_ME
REDIS_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
SESSION_PEPPER=CHANGE_ME_AT_LEAST_32_CHARS
ADMIN_EMAIL=admin@campus.local
ADMIN_PASSWORD=CHANGE_ME_AT_LEAST_12_CHARS
ADMIN_TOTP_SECRET=CHANGE_ME_BASE32
ALLOW_DEMO_LOGIN=false
AUTO_PUBLISH_SAFE=true
INVITE_CODE=
WX_APPID=
WX_SECRET=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
IMAGE_SAFETY_URL=
IMAGE_SAFETY_TOKEN=
IMAGE_SAFETY_TIMEOUT_MS=5000
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=ap-guangzhou
COS_CDN_BASE=
